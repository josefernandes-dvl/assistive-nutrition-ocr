      "condicao": "leitura limpa (controle)",
      "termos_esperados": ["farinha de trigo", "soro de leite", "lecitina de soja"],
      "disorders": ["Doença Celíaca"],
      "expected_trigger": "trigo"
    },
    {
      "arquivo": "L02.png",
      "condicao": "rotação de +3°",
      "termos_esperados": ["leite integral", "lactose"],
      "disorders": ["Intolerância à Lactose"],
      "expected_trigger": "leite"
    },
    {
      "arquivo": "L03.png",
      "condicao": "rotação de -6° sobre fundo acinzentado",
      "termos_esperados": ["amendoins torrados", "aveia"],
      "disorders": ["Alergia ao Amendoim"],
      "expected_trigger": "amendoim"
    },
    {
      "arquivo": "L04.png",
      "condicao": "desfoque gaussiano (foco imperfeito)",
      "termos_esperados": ["shoyu", "soja"],
      "disorders": ["Alergia à Soja"],
      "expected_trigger": "soja"
    },
    {
      "arquivo": "L05.png",
      "condicao": "ruído de sensor (pouca luz)",
